# Copy file này thành .env và điền giá trị. KHÔNG commit file .env.
# File được đọc ở 2 nơi:
#   - docker compose: thay biến ${...} trong docker-compose.yaml và truyền vào container app/maven (env_file)
#   - app chạy bằng JDK local: spring.config.import (application.yml) — biến môi trường của hệ điều hành vẫn được ưu tiên hơn
# Quy ước: chỉ ghi giá trị không có dấu nháy, chỉ dùng chữ/số cho mật khẩu (tránh $, #, \).
# Biến không dùng thì để nguyên dấu # ở đầu dòng — dòng "KEY=" (rỗng) sẽ ghi đè giá trị mặc định
# trong application*.yml thành chuỗi rỗng (vd. OAuth client-id rỗng làm app không khởi động).

# ===== Bắt buộc =====

# MySQL — compose tạo database + user này lần đầu khởi động (đổi sau đó phải xoá volume: docker compose down -v)
DB_NAME=foodsndrinks
DB_USERNAME=foodsndrinks
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ActiveMQ Artemis (broker của compose; app chưa dùng JMS)
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=

# Múi giờ JVM của container app/maven (compose truyền vào container dưới tên TZ — biến mà JVM đọc).
# OrderService/OrderStatisticsScheduler dùng LocalDateTime.now()/LocalDate.now() (múi giờ JVM) để tính ngày/tháng
# của đơn và báo cáo → mọi instance phải dùng CHUNG một giá trị. Image đã mặc định Asia/Ho_Chi_Minh (Dockerfile).
# Chỉ có tác dụng với container chạy qua compose: app chạy bằng JDK local không đổi múi giờ JVM qua file này
# (dùng múi giờ của máy hoặc -Duser.timezone=Asia/Ho_Chi_Minh); docker run không qua compose thì dùng -e TZ=...
APP_TZ=Asia/Ho_Chi_Minh

# ===== Tuỳ chọn =====

# Port mở ra máy host (chỉ bind 127.0.0.1). MySQL dùng 33070 để không trùng MySQL cài sẵn ở 3306.
# DB_HOST_PORT=33070
# APP_PORT=8080
# ARTEMIS_PORT=61616
# ARTEMIS_CONSOLE_PORT=8161

# Profile của container app (mặc định dev: bật Swagger UI, log DEBUG). prod thì phải đặt thêm JWT_SECRET, REMEMBER_ME_KEY.
# SPRING_PROFILES_ACTIVE=dev

# App chạy bằng JDK local nhưng dùng MySQL của compose: bỏ comment dòng dưới (port phải khớp DB_HOST_PORT).
# Container app/maven không dùng giá trị này (compose tự trỏ tới service mysql).
# DB_FOODSNDRINKS_URL=jdbc:mysql://localhost:33070/foodsndrinks?serverTimezone=UTC

# UID/GID của user máy host — container app chạy bằng user này để ghi được uploads/, logs/ (bind mount) và file ghi ra
# vẫn thuộc user máy host. Linux/WSL2: lấy bằng `id -u` / `id -g` nếu khác 1000.
# (Container maven tự nhận diện chủ sở hữu thư mục project, không dùng biến này.)
# Docker Desktop (Windows/Mac) để mặc định là được.
# HOST_UID=1000
# HOST_GID=1000

# JWT (>= 32 byte / 256 bit). Profile dev không đặt thì tự sinh khoá ngẫu nhiên 256 bit mỗi khi context khởi động —
# token cũ hết hiệu lực sau mỗi lần restart, kể cả hot restart của devtools; muốn giữ token khi dev thì đặt biến này.
# Prod bắt buộc. Sinh bằng: openssl rand -base64 48
# JWT_SECRET=
# Key cookie remember-me. Profile dev tự sinh ngẫu nhiên mỗi lần khởi động; prod bắt buộc.
# REMEMBER_ME_KEY=

# Từ chối mật khẩu mới đã bị lộ (gọi api.pwnedpasswords.com, chỉ gửi 5 ký tự đầu SHA-1; lỗi/timeout thì cho qua).
# Đặt false khi máy không ra được Internet.
# PASSWORD_BREACH_CHECK_ENABLED=true

# OAuth2 login — redirect URI khai báo ở console của provider: http://localhost:8080/login/oauth2/code/{google|facebook|twitter}
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Mail (mặc định host Mailtrap sandbox). Không có username/password thì gửi mail thất bại và chỉ ghi log.
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_NOTIFY_ENABLED=true
# ADMIN_NOTIFY_EMAIL=admin@example.com

# Slack incoming webhook — trống thì bỏ qua thông báo Slack
# SLACK_WEBHOOK_URL=
# SLACK_NOTIFY_ENABLED=true

# Cron báo cáo tháng (mặc định 23h ngày cuối tháng, theo múi giờ JVM — APP_TZ khi chạy bằng compose)
# ORDER_STATS_CRON=0 0 23 L * *

# ===== Chạy nhiều instance sau load balancer =====

# Định danh instance (mặc định hostname — container/pod đã có hostname riêng). In trong mỗi dòng log, là service.node.name
# của audit.log, và là thư mục log riêng logs/<INSTANCE_ID>/ ở profile prod. Mỗi instance phải khác nhau.
# INSTANCE_ID=app-1
# Dải IP (CIDR, cách nhau bởi dấu phẩy) của load balancer — profile prod chỉ tin X-Forwarded-For/X-Forwarded-Proto
# từ các IP này (lấy IP client thật cho audit log). BẮT BUỘC ở profile prod (không có default, app không khởi động nếu
# thiếu hoặc rỗng); dev không dùng.
# TRUSTED_PROXIES=10.0.1.0/24
