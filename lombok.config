config.stopBubbling = true
# @RequiredArgsConstructor copy @Qualifier của field sang tham số constructor, để bean có nhiều ứng viên
# (vd. executor: @Qualifier(AsyncConfig.DASHBOARD_EXECUTOR)) vẫn dùng được constructor injection qua Lombok.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
# @Lazy trên field → tham số constructor được inject bằng lazy proxy (bean tạo trong chính cấu hình đang khởi tạo, vd.
# messageBrokerTaskScheduler trong WebSocketConfig). Không thêm @Value: @Value trên field làm Spring inject field lần nữa
# — dùng record @ConfigurationProperties ở config/properties.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
