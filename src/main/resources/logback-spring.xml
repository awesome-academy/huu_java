<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cấu hình log của app (Spring Boot tự nạp file này thay cho cấu hình mặc định).
  - dev, prod: console + foodsndrinks.log (text, ghi bất đồng bộ qua AsyncAppender; xoay vòng theo ngày hoặc
    khi vượt 10MB, giữ 30 ngày, tối đa 1GB).
  - prod: thêm audit.log cho logger AUDIT — JSON (ECS), ghi đồng bộ để không mất sự kiện (giữ 90 ngày).
  - Thư mục file: dev là logs/; prod là logs/<app.instance-id>/ — khi chạy nhiều instance sau load balancer dùng chung
    thư mục log (vd. cùng bind mount ./logs), mỗi instance ghi và xoay vòng file của riêng nó, không ghi đè/xoá file
    của instance khác. Định danh instance (app.instance-id, mặc định hostname) cũng được in trong mỗi dòng log.
  - Profile test (luôn bật khi chạy test, xem src/test/resources/config/application.yml) hoặc không bật dev/prod:
    chỉ console, để log của test không lẫn vào logs/foodsndrinks.log.
  Thư mục log đổi được qua logging.file.path / LOGGING_FILE_PATH. Mức log từng package đặt trong application-*.yml.

  Chống log injection (giả mạo dòng log) — converter trong package logging:
  - %safeMsg: như %msg, thay ký tự ngắt dòng (CR, LF, U+0085, U+2028, U+2029) và ký tự điều khiển/vô hình bằng "_".
  - %safeEx: như %wEx, nhưng làm sạch message của exception (thường chứa dữ liệu người dùng).
  - %safeKvp: in key-value của SLF4J fluent API (audit) theo kiểu logfmt, giá trị đặc biệt được đặt trong nháy kép.
  MDC: requestId (RequestIdFilter, do server sinh), clientRequestId (X-Request-Id hợp lệ của client, in thành cid=...),
  user.name (MdcUserFilter; tên theo ECS để audit.log JSON có "user":{"name":...}).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="safeMsg" class="com.huuhv.foodsndrinks.logging.SafeMessageConverter"/>
    <conversionRule conversionWord="safeEx" class="com.huuhv.foodsndrinks.logging.SafeThrowableProxyConverter"/>
    <conversionRule conversionWord="safeKvp" class="com.huuhv.foodsndrinks.logging.SafeKeyValuePairsConverter"/>

    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>
    <springProperty scope="context" name="INSTANCE_ID" source="app.instance-id" defaultValue="unknown"/>

    <springProfile name="!prod">
        <property name="APP_LOG_DIR" value="${LOG_DIR}"/>
    </springProfile>
    <springProfile name="prod">
        <property name="APP_LOG_DIR" value="${LOG_DIR}/${INSTANCE_ID}"/>
    </springProfile>

    <!-- [instance] [requestId] hoặc [requestId cid=<X-Request-Id của client>], sau đó [user] -->
    <property name="MDC_PATTERN"
              value="[${INSTANCE_ID}] [%X{requestId:-}%replace(%X{clientRequestId}){'^(.+)$', ' cid=$1'}] [%X{user.name:-}]"/>
    <property name="CONSOLE_PATTERN"
              value="%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}){faint} %clr(%5p) %clr([%15.15t]){faint} %clr(${MDC_PATTERN}){magenta} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %safeMsg%safeKvp%n%safeEx"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%t] ${MDC_PATTERN} %-40.40logger{39} : %safeMsg%safeKvp%n%safeEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- Sự kiện bảo mật (xem service/audit/AuditLogService). Khai báo level ở đây để không bị root WARN của prod chặn. -->
    <logger name="AUDIT" level="INFO"/>

    <springProfile name="test | (!dev &amp; !prod)">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="(dev | prod) &amp; !test">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${APP_LOG_DIR}/foodsndrinks.log</file>
            <encoder>
                <pattern>${FILE_PATTERN}</pattern>
                <charset>${FILE_LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${APP_LOG_DIR}/foodsndrinks.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- Ghi file trên thread riêng: thread request không phải chờ đĩa chậm/nén file khi xoay vòng.
             discardingThreshold=0 + neverBlock=false: không bỏ log nào, hàng đợi đầy thì mới chặn thread gọi. -->
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <neverBlock>false</neverBlock>
            <appender-ref ref="FILE"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod &amp; !test">
        <!-- JSON theo Elastic Common Schema: mỗi sự kiện 1 dòng, MDC + key-value thành field (escape chuẩn JSON).
             Ghi đồng bộ, không qua AsyncAppender, để không mất sự kiện audit khi app dừng đột ngột. -->
        <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${APP_LOG_DIR}/audit.log</file>
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>${FILE_LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${APP_LOG_DIR}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>90</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- additivity mặc định = true: sự kiện audit vẫn có trong console/foodsndrinks.log để truy vết theo requestId
             trong cùng một file với log thường của request đó -->
        <logger name="AUDIT" level="INFO">
            <appender-ref ref="AUDIT_FILE"/>
        </logger>
    </springProfile>
</configuration>
