<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.10</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.huuhv</groupId>
	<artifactId>foodsndrinks</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- WebJars front-end (không có trong Spring Boot BOM) -->
		<bootstrap.version>5.3.2</bootstrap.version>
		<font-awesome.version>6.4.2</font-awesome.version>
		<chartjs.version>4.4.0</chartjs.version>
		<stompjs.version>7.1.1</stompjs.version>
		<dependency-check.version>13.0.0</dependency-check.version>
		<!-- Không có trong Spring Boot BOM. 0.8.14 là bản đầu tiên hỗ trợ chính thức class file Java 25 -->
		<jacoco.version>0.8.14</jacoco.version>
		<!-- Không có trong Spring Boot BOM. Dòng 7.x build trên Spring Framework 7 -->
		<shedlock.version>7.10.1</shedlock.version>
		<!-- Ghi đè 2.43.0 của BOM Spring Boot 4.0.x:
		     - 2.43.0 không khởi động broker embedded trên JDK 24+ (Subject.getSubject → UnsupportedOperationException);
		     - ActiveMQ Artemis 2.11.0–2.44.0 dính CVE-2026-27446 (CVSS 9.8, broker bị ép nối federation Core ra broker giả
		       mạo), sửa từ Apache Artemis 2.52.0.
		     Từ 2.50 dự án đổi groupId sang org.apache.artemis: các artifact org.apache.activemq:artemis-* mà BOM Boot quản lý
		     (vd. artemis-jakarta-client của spring-boot-starter-artemis) ở version này chỉ là POM relocation sang groupId mới.
		     Bỏ dòng này khi BOM Boot >= 2.52. Giữ cùng version với image apache/artemis trong docker-compose.yaml. -->
		<artemis.version>2.57.0</artemis.version>
		<!-- Không có trong Spring Boot BOM. Dòng 5.x ổn định mới nhất (6.0.0 mới phát hành 10/2026, chưa dùng) -->
		<poi.version>5.5.1</poi.version>
		<!-- Sinh class JAXB từ XSD của SOAP (goal xjc). Không có trong Spring Boot BOM. Dòng 4.x sinh code jakarta.xml.bind
		     (JAXB 4) và chạy được trên JDK 25 -->
		<jaxb2-maven-plugin.version>4.2.0</jaxb2-maven-plugin.version>
	</properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- JMS (Jakarta Messaging) với ActiveMQ Artemis — config/JmsConfig. Broker embedded trong JVM (dev/test) cần
             artemis-jakarta-server; container app của compose và prod nối broker riêng (spring.artemis.mode=native,
             spring.artemis.embedded.enabled=false — xem config/ArtemisEmbeddedConfig) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-jakarta-server</artifactId>
            <version>${artemis.version}</version>
        </dependency>
        <!-- WebSocket + STOMP (config/WebSocketConfig): simple broker trong bộ nhớ từng instance, sự kiện giữa các instance đi
             qua topic JMS. spring-security-messaging: phân quyền frame STOMP + CSRF ở frame CONNECT
             (config/WebSocketSecurityConfig, @EnableWebSocketSecurity) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-messaging</artifactId>
        </dependency>
        <!-- Session HTTP lưu trong MySQL (Spring Session JDBC, bảng SPRING_SESSION* do Flyway tạo): mọi instance sau load
             balancer dùng chung session — không cần sticky, instance chết không làm user bị đăng xuất. Cấu hình:
             config/SessionStoreConfig (pool connection riêng cho kho session) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Auto map Entity vs DTO -->
        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Caffeine Cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ShedLock: job @Scheduled chỉ chạy trên một instance khi có nhiều instance sau load balancer
             (khoá lưu trong bảng shedlock của MySQL dùng chung — config/SchedulerLockConfig) -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- Apache POI: export/import Excel .xlsx (service/excel). Export dùng SXSSF (streaming, file tạm trên đĩa) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- SOAP (Spring-WS, contract-first — config/WebServiceConfig, controller/soap): XSD ở src/main/resources/xsd, class
             JAXB sinh lúc build bằng jaxb2-maven-plugin (target/generated-sources/jaxb, không commit). wsdl4j: sinh WSDL
             từ XSD (DefaultWsdl11Definition); jaxb-runtime: implementation JAXB 4 lúc chạy. Version theo Spring Boot BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices</artifactId>
        </dependency>
        <dependency>
            <groupId>wsdl4j</groupId>
            <artifactId>wsdl4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- springdoc 3.x là dòng tương thích Spring Boot 4 / Framework 7 (2.x chỉ cho Boot 3) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>

        <!-- Thư viện front-end tự host qua WebJars (phục vụ tại /webjars/**, thay CDN): CSP chỉ cần 'self', không phụ
             thuộc CDN bên ngoài, và OWASP Dependency-Check quét được các thư viện này. webjars-locator-lite (Boot quản lý
             version) cho phép URL không chứa version: /webjars/bootstrap/css/bootstrap.min.css -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>${bootstrap.version}</version>
            <exclusions>
                <!-- Dùng bootstrap.bundle.min.js (đã gồm Popper) -->
                <exclusion>
                    <groupId>org.webjars</groupId>
                    <artifactId>popper.js</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>font-awesome</artifactId>
            <version>${font-awesome.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>chart.js</artifactId>
            <version>${chartjs.version}</version>
            <exclusions>
                <!-- dist/chart.umd.js đã đóng gói sẵn @kurkle/color (WebJar này khai báo bằng version range) -->
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>kurkle__color</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Client STOMP cho trình duyệt (static/js/realtime.js): bundles/stomp.umd.min.js, không dùng eval → CSP giữ
             script-src 'self'. Chỉ WebSocket thuần, không SockJS -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>stomp__stompjs</artifactId>
            <version>${stompjs.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 tách MockMvc test support (@AutoConfigureMockMvc, @WebMvcTest) ra module riêng -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 tách phần gắn Spring Security vào MockMvc tự cấu hình (springSecurity() configurer) ra module riêng:
             thiếu module này thì @WithMockUser / user(...) không có tác dụng với @AutoConfigureMockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Integration test chạy trên MySQL do Testcontainers tạo (TestcontainersConfiguration, @ServiceConnection) —
             cần Docker khi chạy test. Version theo Spring Boot BOM (Testcontainers 2.x: artifact có tiền tố testcontainers-) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebServiceServerTest + MockWebServiceClient (spring-ws-test): test endpoint SOAP không cần web server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- OWASP Dependency-Check (Top 10 A06): quét CVE của dependency. KHÔNG gắn vào lifecycle (không có
			     <executions>) để ./mvnw test vẫn nhanh — chạy riêng trước khi tạo PR có thêm/đổi dependency:
			       ./mvnw dependency-check:check   (Docker: lệnh trong README, mục "Quét Lỗ Hổng Thư Viện")
			     NVD API key (bắt buộc từ bản 12+) đọc từ biến môi trường NVD_API_KEY, không ghi vào pom. Dữ liệu NVD cache
			     trong ~/.m2/repository/org/owasp/dependency-check-data (volume maven-repo khi chạy bằng Docker).
			     Báo cáo: target/dependency-check-report.html (+ .json). Fail khi có lỗ hổng CVSS >= 7. -->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>${dependency-check.version}</version>
				<configuration>
					<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
					<failBuildOnCVSS>7</failBuildOnCVSS>
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
					<suppressionFiles>
						<suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
					</suppressionFiles>
					<!-- Sonatype OSS Index bắt buộc tài khoản riêng; nguồn chính là NVD. RetireJS giữ bật: quét JS trong
					     WebJars (Bootstrap, Chart.js) và static/js. Tắt các analyzer .NET/Node không dùng (cần npm/dotnet). -->
					<ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
					<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
					<nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
					<nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
					<nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
					<nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
					<yarnAuditAnalyzerEnabled>false</yarnAuditAnalyzerEnabled>
					<pnpmAuditAnalyzerEnabled>false</pnpmAuditAnalyzerEnabled>
				</configuration>
			</plugin>
			<!-- Coverage: prepare-agent gắn JaCoCo agent vào JVM test (qua property argLine của surefire), report sinh
			     target/site/jacoco/index.html (+ jacoco.xml, jacoco.csv) ngay sau ./mvnw test. Chưa đặt ngưỡng chặn build. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- Class JAXB sinh từ XSD (jaxb2-maven-plugin) không phải code của dự án -->
					<excludes>
						<exclude>com/huuhv/foodsndrinks/soap/**</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- SOAP contract-first: sinh class JAXB từ XSD vào target/generated-sources/jaxb ở phase generate-sources (plugin
			     tự thêm thư mục đó làm source root). Mỗi XSD một execution + một package riêng dưới
			     com.huuhv.foodsndrinks.soap; clearOutputDir=false để các execution không xoá kết quả của nhau.
			     KHÔNG sửa tay, không commit class sinh ra — sửa XSD rồi build lại. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>${jaxb2-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>xjc-store</id>
						<goals>
							<goal>xjc</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/resources/xsd/foodsndrinks.xsd</source>
							</sources>
							<packageName>com.huuhv.foodsndrinks.soap.store</packageName>
							<clearOutputDir>false</clearOutputDir>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Test chỉ chạy với profile "test", không bao giờ với dev: application-dev.yml thắng
			     src/test/resources/config/application.yml nên dev bật thì test dùng datasource/secret của dev (.env).
			     System property thắng cả SPRING_PROFILES_ACTIVE của môi trường. Áp dụng cho mọi test chạy qua Maven,
			     kể cả test không dùng @IntegrationTest (annotation này tự đặt @ActiveProfiles("test") khi chạy trong IDE).
			     Bỏ qua integration test (cần Docker): ./mvnw test -DexcludedGroups=integration -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
